RECAPTCHA_SITE_KEY=6LclqvMsAAAAAFKkDSOS0rMCFrMyUdm9iuMMM5_2
# Proyecto Segunda Opinión Médica con los 221 recursos FHIR cargados y verificados (reapuntado desde b18065e2, borrado).
MEDPLUM_PROJECT_ID=7ce5e559-f315-4538-abf2-61fa4922f996
# Marca blanca (opcional): pisan a src/marca.json sin tocar código. Vacías = se usa el JSON.
# MARCA_NOMBRE=
# MARCA_NOMBRE_CONSENTIMIENTO=
# MARCA_RESPONSABLE=
# MARCA_DIRIGIDO_POR=
# MARCA_DIRECCION=
